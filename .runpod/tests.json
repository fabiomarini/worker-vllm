{
  "tests": [
    {
      "name": "basic_inference_test",
      "input": {
        "prompt": "Write a short poem about artificial intelligence."
      },
      "timeout": 30000
    },
    {
      "name": "openai_messages_test",
      "input": {
        "openai_route": "/v1/chat/completions",
        "openai_input": {
          "messages": [
            {
              "role": "system",
              "content": "You are a helpful assistant that writes concise responses."
            },
            {
              "role": "user",
              "content": "Explain what a neural network is in one sentence."
            }
          ],
          "max_tokens": 200,
          "temperature": 0.1
        }
      },
      "timeout": 30000
    }
  ],
  "config": {
    "gpuTypeId": "NVIDIA RTX PRO 6000 Blackwell Workstation Edition",
    "gpuCount": 1,
    "env": [
      {
        "key": "MODEL_NAME",
        "value": "Qwen/Qwen3.6-27B-FP8"
      },
      {
        "key": "TOOL_CALL_PARSER",
        "value": "qwen3_coder"
      },
      {
        "key": "REASONING_PARSER",
        "value": "qwen3"
      },
      {
        "key": "DEFAULT_CHAT_TEMPLATE_KWARGS",
        "value": "{\"temperature\":1.0,\"top_p\":0.95,\"top_k\":20,\"min_p\":0.0,\"presence_penalty\":0.0,\"repetition_penalty\":1.0}"
      }
    ],
    "allowedCudaVersions": ["13"]
  }
}
